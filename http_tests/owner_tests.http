###
# Datalogger endpoints (Owner)
###

# Create a new datalogger (Owner)
# @name create_datalogger
POST {{api}}/businesses/{{own_business_uuid}}/dataloggers
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Owner Test Datalogger",
  "description": "A test datalogger created by Owner.",
  "mac_address": "00:11:22:33:44:55",
  "table_name": "datalogger_owner_test_table",
  "is_active": true
}

###
@datalogger_uuid = {{create_datalogger.response.body.item.uuid}}

###

# Create a new datalogger with image (Owner)
# Note: Create a test.jpg file in the root directory for this to work.
