###
# Get all alarms as Owner 
GET {{api}}/businesses/{{business_mdvsrl}}/alarms
Authorization: Bearer {{ownerLogin.response.body.token}}


###
# Get all alarms as Admin
GET {{api}}/businesses/{{business_mdvsrl}}/alarms
Authorization: Bearer {{adminLogin.response.body.token}}


###
# Get all alarms as Technician
GET {{api}}/businesses/{{business_mdvsrl}}/alarms
Authorization: Bearer {{technicianLogin.response.body.token}}


### //`/api/businesses/${businessUuid}/alarms/${alarmId}`
GET {{api}}/businesses/{{business_mdvsrl}}/alarms/b1c2d3e4-0001-4a7b-8c9d-0e1f2a3b4c5d
Authorization: Bearer {{ownerLogin.response.body.token}}

### //`/api/businesses/${businessUuid}/alarms/user/${userId}`
GET {{api}}/businesses/{{business_guemes}}/alarms/user/{{user_norberto}}
Authorization: Bearer {{ownerLogin.response.body.token}}





###
# Create a new alarm as Owner /api/businneses/4e329ada-8511-4bfa-8d44-57a0ca4fd80c/alarms
POST {{api}}/businesses/{{business_mdvsrl}}/alarms
Authorization: Bearer {{ownerLogin.response.body.token}}
Content-Type: application/json

{
    "name": "New Test Alarm",
    "description": "A test alarm created by the owner.",
    "channel_uuid": "sdfsd1232ds-sda213-sd-asdadsa-213sd",
    "table_name": "cocina",
    "column_name": "d1",
    "time_range": 300,
    "condition_logic": "value > 50",
    "condition_show": "Value > 50",
    "alarm_type": "upper_threshold",
    "var01": 50,
    "is_active": true,
    "triggered": false
}

###
# Update an alarm as Owner
PUT {{api}}/alarms/{{alarm_cafetera_mdvsrl}}
Authorization: Bearer {{ownerLogin.response.body.token}}
Content-Type: application/json

{
    "name": "Updated High Temperature Alert"
}

###
# Delete an alarm as Owner
DELETE {{api}}/alarms/{{alarm_cafetera_mdvsrl}}
Authorization: Bearer {{ownerLogin.response.body.token}}


###
# Create a new alarm as Admin
POST {{api}}/alarms
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
    "channel_uuid": "a1b2c3d4-e5f6-a7b8-c9d0-e1f2a3b4c5d6",
    "name": "Admin Test Alarm",
    "description": "A test alarm created by the admin.",
    "time_range": 600,
    "condition_logic": "value < 10",
    "condition_show": "Value < 10",
    "alarm_type": "lower_threshold",
    "var01": 10
}
